{
  "name": "quotaswitch",
  "version": "0.3.0",
  "description": "Unified quota-driven multi-account switcher for Google Antigravity (agy) and OpenAI Codex",
  "license": "MIT",
  "author": "lifan-builds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifan-builds/quotaswitch.git"
  },
  "homepage": "https://github.com/lifan-builds/quotaswitch#readme",
  "bugs": {
    "url": "https://github.com/lifan-builds/quotaswitch/issues"
  },
  "bin": {
    "quotaswitch": "npm/bin/quotaswitch.js",
    "agy-auth": "npm/bin/quotaswitch.js"
  },
  "files": [
    "npm/",
    "README.md",
    "LICENSE",
    "assets/"
  ],
  "scripts": {
    "build": "go build -o bin/quotaswitch ./cmd/quotaswitch",
    "dev:prepare": "node scripts/build-npm.mjs --current",
    "prepack": "node scripts/build-npm.mjs --all",
    "test": "go test ./..."
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "quotaswitch",
    "antigravity",
    "agy",
    "openai",
    "codex",
    "account-switcher",
    "quota",
    "oauth",
    "cli"
  ]
}
